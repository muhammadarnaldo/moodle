{{!
    @template core_courseformat/local/content/cm/cmiconfallback

    The server-rendered icon of a course module.

    It is displayed on its own when the design system has no icon for the activity, and inside the
    cmicon React mount point until the ActivityIcon component takes over.

    Example context (json):
    {
        "icon": "../../../pix/help.svg",
        "iconclass": "",
        "purpose": "content",
        "branded": 0,
        "modname": "resource",
        "pluginname": "File"
    }
}}
<div class="activityiconcontainer smaller {{purpose}} {{#branded}}isbranded{{/branded}} courseicon">
    <img
        src="{{{icon}}}"
        class="activityicon {{iconclass}}"
        data-region="activity-icon"
        data-id="{{cmid}}"
        alt=""
    >
</div>
